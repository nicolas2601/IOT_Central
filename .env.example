# ============================================
# CONFIGURACIÓN PARA COOLIFY - IOT CENTRAL
# ============================================
# Copia este archivo a .env y configura las variables

# ============================================
# DOMINIOS AUTOGENERADOS DE COOLIFY
# ============================================
# IMPORTANTE: Reemplazar con los dominios reales generados por Coolify
FRONTEND_DOMAIN=iotcentral-frontend-abc123.coolify.domain.com
BACKEND_DOMAIN=iotcentral-backend-def456.coolify.domain.com
MQTT_DOMAIN=iotcentral-mqtt-ghi789.coolify.domain.com

# URLs completas (generadas automáticamente a partir de los dominios)
FRONTEND_URL=http://${FRONTEND_DOMAIN}
BACKEND_URL=http://${BACKEND_DOMAIN}
MQTT_URL=http://${MQTT_DOMAIN}

# ============================================
# DJANGO BACKEND CONFIGURATION
# ============================================
# Clave secreta de Django (GENERAR UNA NUEVA EN PRODUCCIÓN)
SECRET_KEY=django-insecure-GENERAR-CLAVE-SEGURA-EN-PRODUCCION-muy-larga-y-aleatoria-123456789

# Modo debug (SIEMPRE False en producción)
DEBUG=False

# Hosts permitidos (incluir dominios de Coolify)
ALLOWED_HOSTS=${BACKEND_DOMAIN},${FRONTEND_DOMAIN},localhost,127.0.0.1

# Configuración CORS
CORS_ORIGIN=${FRONTEND_URL}

# Log level
LOG_LEVEL=INFO

# ============================================
# BASE DE DATOS NEON POSTGRESQL
# ============================================
# Configuración de conexión a Neon PostgreSQL
POSTGRES_DB=iotcentral_db
POSTGRES_USER=tu_usuario_neon
POSTGRES_PASSWORD=tu_password_neon
POSTGRES_HOST=tu-proyecto.neon.tech
POSTGRES_PORT=5432

# URL completa de conexión (alternativa)
# DATABASE_URL=postgresql://usuario:password@host:port/database?sslmode=require

# ============================================
# MQTT BROKER CONFIGURATION
# ============================================
# Host del broker MQTT (usar nombre del servicio Docker)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# WebSocket MQTT (para frontend)
MQTT_WS_PORT=9001

# ============================================
# CONFIGURACIÓN DE DESPLIEGUE
# ============================================
# Puerto del backend (daphne)
BACKEND_PORT=8001

# Puerto del frontend
FRONTEND_PORT=3000

# Puerto MQTT estándar
MQTT_PORT=1883

# Puerto MQTT WebSocket
MQTT_WS_PORT=9001

# ============================================
# CONFIGURACIÓN ESPECÍFICA DE COOLIFY
# ============================================
# Labels adicionales si son necesarios
COOLIFY_PROJECT=iotcentral
COOLIFY_ENVIRONMENT=production

# ============================================
# VARIABLES DE ENTORNO PARA FRONTEND
# ============================================
# Estas variables deben estar disponibles durante el build del frontend
NEXT_PUBLIC_API_URL=${BACKEND_URL}/api
NEXT_PUBLIC_WS_URL=${BACKEND_URL}/ws

# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================
# Configuración adicional de seguridad si es necesaria
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,http

# ============================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# ============================================
# Si se necesita Redis para channels/cache en el futuro
# REDIS_URL=redis://redis:6379/0

# ============================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ============================================
# Para notificaciones por email si se implementa
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password

# ============================================
# CONFIGURACIÓN DE MONITOREO (OPCIONAL)
# ============================================
# Para herramientas de monitoreo si se implementan
# SENTRY_DSN=https://your-sentry-dsn-here
# NEW_RELIC_LICENSE_KEY=your-license-key

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Reemplazar TODOS los valores de ejemplo con valores reales
# 2. Los dominios de Coolify se generan automáticamente al crear el proyecto
# 3. La base de datos Neon debe estar creada y configurada previamente
# 4. NUNCA commitear el archivo .env real al repositorio
# 5. Generar una SECRET_KEY segura para producción
# 6. Verificar que todos los puertos estén disponibles en el servidor
