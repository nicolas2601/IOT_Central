# ============================================
# VARIABLES DE ENTORNO - PLATAFORMA IOT
# ============================================
# Copia este archivo a .env y configura tus valores

# ============================================
# BACKEND - DJANGO
# ============================================

# Modo de desarrollo (True para desarrollo, False para producción)
DEBUG=True

# Clave secreta de Django (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=django-insecure-dev-key-change-in-production-with-random-string

# ============================================
# BASE DE DATOS - POSTGRESQL
# ============================================

POSTGRES_DB=iotdb
POSTGRES_USER=iotuser
POSTGRES_PASSWORD=iotuser1234
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================

REDIS_URL=redis://redis:6379/0

# ============================================
# MQTT BROKER - MOSQUITTO
# ============================================

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# ============================================
# SEGURIDAD
# ============================================

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# FRONTEND - REACT + VITE
# ============================================

# URL del API backend
VITE_API_URL=http://localhost:8000/api

# URL del WebSocket
VITE_WS_URL=ws://localhost:8000/ws

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================

# Timezone
TZ=America/Bogota

# Nivel de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
