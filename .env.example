# ============================================
# VARIABLES DE ENTORNO - PLATAFORMA IOT
# ============================================
# Para Coolify: Configura estas variables en el panel de Coolify
# Para desarrollo local: Copia este archivo a .env

# ============================================
# BACKEND - DJANGO
# ============================================

# Modo de desarrollo (False para producción)
DEBUG=False

# Clave secreta de Django (GENERAR UNA NUEVA EN PRODUCCIÓN)
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIAR-ESTA-CLAVE-SECRETA-EN-PRODUCCION

# ============================================
# BASE DE DATOS - POSTGRESQL (NEON)
# ============================================

POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_t9pTFV0GNXar
POSTGRES_HOST=ep-fancy-bonus-a8h2fj9n-pooler.eastus2.azure.neon.tech
POSTGRES_PORT=5432

# ============================================
# MQTT BROKER - MOSQUITTO
# ============================================

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# ============================================
# SEGURIDAD
# ============================================

# Hosts permitidos (separados por coma)
# IMPORTANTE: Agregar tu dominio de Coolify aquí
ALLOWED_HOSTS=localhost,127.0.0.1,backend,tu-dominio.com

# Orígenes CORS permitidos (separados por coma)
# IMPORTANTE: Agregar la URL de tu frontend en Coolify
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com

# ============================================
# FRONTEND - NEXT.JS
# ============================================

# URL del API backend
# IMPORTANTE: Cambiar a la URL de tu backend en Coolify
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# URL del WebSocket
# IMPORTANTE: Cambiar a la URL de tu backend en Coolify (ws:// o wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================

# Timezone
TZ=America/Bogota

# Nivel de log (INFO para producción)
LOG_LEVEL=INFO
